  <content_rating type="oars-1.1"/>

  <releases>
    <release version="0.4.0" date="2026-10-23">
      <description>
        <p>First packaged release.</p>
        <ul>
          <li>Drawable equalizer with live spectrum</li>
          <li>Per-channel routing and crossovers for any channel layout</li>
