<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.pjamessteven.SpeakerTuner</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <name>Sound Tuner</name>
  <summary>System-wide EQ, crossovers and loudness for your speakers</summary>

  <developer id="io.github.pjamessteven">
    <name>pjamessteven</name>
  </developer>

  <description>
    <p>
      Get the most out of your laptop speakers, or finely tune your sound system.
      Sound Tuner adds a tuned output in front of any PipeWire sound device, so every
      app plays through it.
    </p>
    <ul>
      <li>An equalizer you can draw, over a live spectrum of what's playing</li>
      <li>Boost with a look-ahead limiter, so it gets louder without clipping</li>
      <li>3D virtual surround and stereo width</li>
      <li>Per-channel routing, crossovers, delay and bass management for 2.0 up to 7.1</li>
      <li>Presets you can name, save and switch between</li>
    </ul>
    <p>
      Processing runs inside PipeWire itself, so your sound stays tuned with the app closed.
      The interface adapts from phones to wide desktop screens.
    </p>
  </description>

  <launchable type="desktop-id">io.github.pjamessteven.SpeakerTuner.desktop</launchable>

  <url type="homepage">https://github.com/pjamessteven/dolbro-sound-tuner</url>
  <url type="bugtracker">https://github.com/pjamessteven/dolbro-sound-tuner/issues</url>
  <url type="vcs-browser">https://github.com/pjamessteven/dolbro-sound-tuner</url>
  <url type="translate">https://github.com/pjamessteven/dolbro-sound-tuner/tree/main/locale</url>

  <screenshots>
